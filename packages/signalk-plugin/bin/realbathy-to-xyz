#!/usr/bin/env node

import { realbathyToXyz } from "../dist/realbathy-cli.js";

const usage =
  "Usage: realbathy-to-xyz --utc-offset <hours> <track.trl>\n" +
  '  --utc-offset  the MFD\'s "Time offset from UTC" when it recorded, e.g. -4';

// Parsed by hand: node's parseArgs takes a negative offset for another option
const args = process.argv.slice(2);
let offset;
const files = [];
for (let i = 0; i < args.length; i++) {
  const arg = args[i];
  if (arg === "--utc-offset") offset = args[++i];
  else if (arg.startsWith("--utc-offset=")) offset = arg.split("=")[1];
  else files.push(arg);
}
// Number("") is 0, which would read an empty offset as UTC
const utcOffset = offset?.trim() ? Number(offset) : NaN;

if (files.length !== 1 || !Number.isFinite(utcOffset)) {
  console.error(usage);
  process.exit(1);
}

try {
  await realbathyToXyz(files[0], { utcOffset });
} catch (err) {
  console.error(
    `realbathy-to-xyz: ${err instanceof Error ? err.message : err}`,
  );
  process.exit(1);
}
