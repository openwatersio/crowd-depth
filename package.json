{
  "name": "crowd-depth-dev",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest",
    "test:e2e": "npm run test:e2e -w crowd-depth",
    "build": "tsc -b",
    "format": "oxlint --fix && prettier --write .",
    "check": "oxlint && prettier --check . && npm run lint --workspaces --if-present",
    "prepare": "husky",
    "start": "npm run start -w crowd-depth-api"
  },
  "devDependencies": {
    "@types/debug": "^4.1.12",
    "@types/node": "^26.6.5",
    "ajv": "^8.17.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "nock": "^15.0.2",
    "oxlint": "^1.88.0",
    "pkg-pr-new": "^0.0.91",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "**/*": [
      "prettier --write --ignore-unknown",
      "oxlint --fix --no-error-on-unmatched-pattern"
    ]
  },
  "workspaces": [
    "packages/*"
  ]
}
